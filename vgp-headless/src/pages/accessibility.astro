---
import Base from '../layouts/Base.astro';
---
<Base title="Accessibility" description="Accessibility statement.">
  <section class="vgp-section">
    <div class="vgp-container" style="max-width:720px;">
      <h1>Accessibility</h1>
      <p>Value Growth Partners targets WCAG 2.2 AA. This site is built with semantic HTML, keyboard navigation, visible focus, and reduced-motion support.</p>
      <p class="vgp-review-flag">[EDITORIAL REVIEW] Finalize the accessibility statement and contact route before launch.</p>
    </div>
  </section>
</Base>
