---
import Base from '../layouts/Base.astro';
const supports = [
  { h: 'Curated founder pipeline', p: 'A steady stream of high-potential consumer brands — sourced, screened, and validated by the ecosystem.' },
  { h: 'Founder readiness & diligence', p: 'We assess founder readiness, business-model strength, and growth potential, surfacing the insight you need to move fast with confidence.' },
  { h: 'Consumer & retail expertise', p: 'Deep sector knowledge across CPG, beauty, wellness, retail, ecommerce, and marketplace-driven brands.' },
  { h: 'Strategic warm introductions', p: 'We connect investors to the right founders — contextually, warmly, and at the right stage.' },
  { h: 'Recurring opportunity flow', p: 'Periodic, curated opportunities aligned with your thesis, mandate, and investment criteria.' },
];
const fits = [
  { h: 'Venture capital firms', p: 'Expand your early- and growth-stage pipeline with investor-ready consumer brands.' },
  { h: 'Emerging managers', p: 'Source differentiated opportunities and build conviction earlier in the journey.' },
  { h: 'Accelerator & platform teams', p: 'Enhance your value-add with scaled founder support and investor connectivity.' },
  { h: 'Consumer-focused investors', p: 'Ideal for those investing in CPG, beauty, wellness, retail, and commerce-enabled brands.' },
];
const steps = [
  ['Discover', 'We attract founders through content, media, podcast, and community.'],
  ['Assess', 'We evaluate founders across readiness, fit, and investment criteria.'],
  ['Prepare', 'We help founders strengthen positioning, strategy, and investor readiness.'],
  ['Connect', 'We facilitate warm introductions to aligned investors and partners.'],
  ['Follow through', 'We support continued diligence, feedback, and partnership execution.'],
];
const refSupports = [
  { h: 'Curated founder introductions', p: 'Context-rich introductions to founders whose needs match your services, expertise, and preferred client profile.' },
  { h: 'Partner visibility engine', p: 'Visibility through the newsletter, Hot List, podcast, founder resource library, and partner spotlights.' },
  { h: 'Strategic context before calls', p: 'We share founder stage, goals, pain points, and urgency so partner conversations start with clarity.' },
  { h: 'Reciprocal referral economics', p: 'A transparent referral structure designed to reward ecosystem collaboration.' },
  { h: 'Long-term relationship flow', p: 'Stay connected to founders as their needs evolve across marketing, operations, funding, retail, and growth systems.' },
];
const refFits = [
  { h: 'Manufacturing, 3PL & logistics', p: 'Partners who help founders move from idea to production, fulfillment, storage, and scale.' },
  { h: 'Creative, digital & paid media', p: 'Design, branding, websites, content, email, paid ads, Amazon, and AI-optimization partners.' },
  { h: 'Legal, accounting & funding advisors', p: 'Professionals who help founders get legally, financially, and capital-ready.' },
  { h: 'Retail, broker & distributor partners', p: 'Operators who help brands access wholesale, retail, distributors, brokers, and marketplace channels.' },
];
const refSteps = [
  ['Join', 'Define partner category, service value, and best-fit founder profile.'],
  ['Signal', 'Gain visibility through curated ecosystem communications.'],
  ['Match', 'Receive context-rich introductions to relevant founders.'],
  ['Deliver', 'Support founder execution while protecting relationship trust.'],
  ['Grow', 'Build repeat referral flow and ecosystem credibility over time.'],
];
// Referral mechanics + guardrails (VGP Referral Partner Program & Fee Structure 2026).
// Fee percentages are intentionally NOT published here — they are gated to approved partners.
const refHow = [
  ['VGP → Partner', 'VGP spots a founder need that fits your expertise and makes a warm introduction. You scope, price, contract, and deliver independently. Referral fees apply if the engagement closes.'],
  ['Partner → VGP', 'You introduce a founder or company to VGP; we scope and contract directly, never interfering in your pricing or delivery. Referral fees apply if the engagement closes.'],
];
const refGuardrails = ['Non-exclusive relationship', 'No guaranteed referral volume', 'Editorial discretion retained by VGP', 'Confidentiality applies', 'Either party may terminate with 30 days’ notice'];
const PARTNER_INTAKE = 'https://forms.gle/fG38XuGXYYeYcEUd6';
---
<Base title="For Investors & Partners" description="Curated founder pipeline, de-risked opportunities, and actionable intelligence — powered by Value Growth Partners.">
  <!-- Hero -->
  <section class="vgp-section">
    <div class="vgp-container" style="max-width:820px;">
      <span class="vgp-eyebrow">For Investors &amp; Partners</span>
      <h1>Curated founder pipeline. Investor-ready opportunities.</h1>
      <p style="font-size:1.25rem; max-width:66ch;">The Brand Blueprint ecosystem is the founder-facing front door for high-potential consumer brands. Powered by Value Growth Partners, we combine media reach, operational advisory, and distribution expertise to identify, validate, and prepare founders for investment — then connect them with the right capital partners. For investors: curated deal flow, de-risked opportunities, and intelligence you can trust.</p>
      <p class="vgp-mt"><a class="vgp-btn vgp-btn--secondary" href="/assets/one-pagers/vgp-investor-one-pager.pdf" download>Download the investor overview (PDF) ↓</a></p>
    </div>
  </section>

  <!-- How we support -->
  <section class="vgp-section vgp-bg-soft">
    <div class="vgp-container">
      <span class="vgp-eyebrow">How we support investor partners</span>
      <h2>Deal flow you can act on with confidence.</h2>
      <div class="vgp-grid vgp-grid--3 vgp-mt">
        {supports.map((s) => (
          <article class="vgp-card"><h4>{s.h}</h4><p style="margin-bottom:0;">{s.p}</p></article>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="vgp-section vgp-bg-navy vgp-center">
    <div class="vgp-container" style="max-width:720px;">
      <p style="font-family:var(--font-serif); font-size:1.9rem; line-height:1.3; color:#fff; margin:0 0 1rem;">“We don’t just connect founders to capital. We connect investors to what’s next.”</p>
      <p style="color:var(--vgp-warm-gold); font-weight:600; margin:0;">Dana Ammons · Founder &amp; Principal, Value Growth Partners</p>
    </div>
  </section>

  <!-- How the ecosystem works -->
  <section class="vgp-section">
    <div class="vgp-container">
      <span class="vgp-eyebrow">How the ecosystem works</span>
      <h2>From first signal to funded partnership.</h2>
      <div class="ip-steps vgp-mt">
        {steps.map(([t, d], i) => (
          <div class="ip-step">
            <span class="ip-num">{i + 1}</span>
            <h4 style="margin:.5rem 0 .35rem;">{t}</h4>
            <p style="font-size:.95rem; margin:0;">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who fits -->
  <section class="vgp-section vgp-bg-pale">
    <div class="vgp-container">
      <span class="vgp-eyebrow">Who this is best for</span>
      <div class="vgp-grid vgp-grid--2 vgp-mt">
        {fits.map((f) => (
          <article class="vgp-card"><h4>{f.h}</h4><p style="margin-bottom:0;">{f.p}</p></article>
        ))}
      </div>
    </div>
  </section>

  <!-- Referral & service partners -->
  <section class="vgp-section vgp-bg-soft">
    <div class="vgp-container">
      <span class="vgp-eyebrow">For Referral &amp; Service Partners</span>
      <h2>Warm founder access. Strategic collaboration.</h2>
      <p style="max-width:72ch;">The Referral Partner Network connects vetted operators, agencies, and service providers with founders who need practical execution support. For partners, we create trusted visibility, warm introductions, and recurring founder demand.</p>

      <h3 class="vgp-mt" style="margin-top:2.5rem;">How we support referral partners</h3>
      <div class="vgp-grid vgp-grid--3 vgp-mt">
        {refSupports.map((s) => <article class="vgp-card"><h4>{s.h}</h4><p style="margin-bottom:0;">{s.p}</p></article>)}
      </div>

      <h3 class="vgp-mt" style="margin-top:2.5rem;">Who this is best for</h3>
      <div class="vgp-grid vgp-grid--2 vgp-mt">
        {refFits.map((f) => <article class="vgp-card"><h4>{f.h}</h4><p style="margin-bottom:0;">{f.p}</p></article>)}
      </div>

      <h3 class="vgp-mt" style="margin-top:2.5rem;">How the ecosystem works</h3>
      <div class="ip-steps vgp-mt">
        {refSteps.map(([t, d], i) => (
          <div class="ip-step"><span class="ip-num">{i + 1}</span><h4 style="margin:.5rem 0 .35rem;">{t}</h4><p style="font-size:.95rem; margin:0;">{d}</p></div>
        ))}
      </div>

      <h3 class="vgp-mt" style="margin-top:2.5rem;">The referral program &amp; fee structure</h3>
      <p style="max-width:72ch;">A reciprocal, transparent program built to reward ecosystem collaboration — with clear guardrails and a fee schedule shared with approved partners.</p>
      <div class="vgp-grid vgp-grid--2 vgp-mt">
        {refHow.map(([t, d]) => <article class="vgp-card"><h4>{t}</h4><p style="margin-bottom:0;">{d}</p></article>)}
      </div>
      <div class="vgp-grid vgp-grid--2" style="margin-top:1.25rem; align-items:start;">
        <article class="vgp-card">
          <h4 style="margin-bottom:.6rem;">Expectations &amp; guardrails</h4>
          <ul class="ip-guardrails">{refGuardrails.map((g) => <li>{g}</li>)}</ul>
        </article>
        <article class="vgp-card ip-gated">
          <span class="ip-lock">Approved partners only</span>
          <h4 style="margin:.35rem 0 .5rem;">Reciprocal fee schedule</h4>
          <p style="margin-bottom:.6rem;">The full structure — referral percentage, the client referral incentive, the first-term window, and the optional visibility-only participation — is shared with partners on acceptance into the program.</p>
          <p style="margin-bottom:0;"><a href={PARTNER_INTAKE} target="_blank" rel="noopener">Apply to join the Referral Partner Program →</a></p>
        </article>
      </div>

      <p class="vgp-mt" style="margin-top:2.5rem;"><a class="vgp-btn vgp-btn--primary" href={PARTNER_INTAKE} target="_blank" rel="noopener" style="margin-right:.5rem;">Apply to become a partner</a><a class="vgp-btn vgp-btn--secondary" href="/network" style="margin-right:.5rem;">See the partner network</a><a class="vgp-btn vgp-btn--secondary" href="/assets/one-pagers/vgp-referral-partner-one-pager.pdf" download>Download the program overview (PDF) ↓</a></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="vgp-section vgp-bg-navy vgp-center">
    <div class="vgp-container" style="max-width:640px;">
      <h2 style="font-size:var(--vgp-h3);">Let’s build better portfolios together.</h2>
      <p style="max-width:54ch; margin:0 auto 1.75rem;">Partner with VGP to access curated deal flow, sector intelligence, and founder insight that helps you invest with clarity and confidence.</p>
      <p><a class="vgp-btn vgp-btn--primary" href="/institutional-inquiry">Start the conversation</a></p>
    </div>
  </section>

  <style>
    .ip-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.25rem; }
    .ip-step { border-top: 3px solid var(--vgp-warm-gold); padding-top: 1rem; }
    .ip-num { font-family: var(--font-serif); font-size: 2rem; color: var(--vgp-blueprint-blue); }
    .ip-guardrails { margin: 0; padding-left: 1.1rem; }
    .ip-guardrails li { margin-bottom: .3rem; font-size: .95rem; }
    .ip-gated { border: 1px solid var(--vgp-warm-gold); background: rgba(0,0,0,.02); }
    .ip-lock { display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--vgp-warm-gold); }
    @media (max-width: 900px) { .ip-steps { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 520px) { .ip-steps { grid-template-columns: 1fr; } }
  </style>
</Base>
