---
import Base from '../../layouts/Base.astro';
import { getPrograms } from '../../lib/content';
export async function getStaticPaths() {
  const items = await getPrograms();
  return items.map((p) => ({ params: { slug: p.slug }, props: { item: p } }));
}
const { item } = Astro.props;
---
<Base title={item.title} description={item.summary}>
  <article class="vgp-section">
    <div class="vgp-container" style="max-width:760px;">
      <nav aria-label="Breadcrumb"><a href="/programs">Programs</a> / {item.title}</nav>
      <h1>{item.title}</h1>
      <p style="font-size:1.25rem;">{item.summary}</p>
      <h4 class="vgp-mt">Audience & eligibility</h4>
      <p>[EDITORIAL REVIEW] Who this program is designed for.</p>
      <h4>Format</h4>
      <p>[EDITORIAL REVIEW] How the program runs.</p>
      <h4>Outcomes</h4>
      <p>[EDITORIAL REVIEW] The commercial-readiness outcomes for the cohort.</p>
      <div class="vgp-card vgp-bg-pale vgp-center vgp-mt" style="border:none;">
        <h3>Bring this to your organization</h3>
        <p class="vgp-mt"><a class="vgp-btn vgp-btn--primary" href="/institutional-inquiry">Submit an Institutional Inquiry</a></p>
      </div>
    </div>
  </article>
</Base>
