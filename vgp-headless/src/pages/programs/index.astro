---
import Base from '../../layouts/Base.astro';
import { getPrograms } from '../../lib/content';
const programs = await getPrograms();
---
<Base title="Programs" description="Institutional programs from Value Growth Partners.">
  <section class="vgp-section">
    <div class="vgp-container">
      <span class="vgp-eyebrow">Programs</span>
      <h1>Institutional programs</h1>
      <p style="max-width:60ch;">For entrepreneurship support organizations, accelerators and institutions moving cohorts toward commercial readiness.</p>
      <img class="vgp-hero-img vgp-mt" src="/assets/img/vgp-programs-cohort.jpg" alt="Dana Ammons leading a cohort advisory session by video" width="1536" height="1024" />
      <div class="vgp-grid vgp-grid--2 vgp-mt">
        {programs.map((p) => (
          <article class="vgp-card">
            {p.image && <img class="vgp-card-thumb" src={p.image} alt="" width="1536" height="1024" loading="lazy" />}
            <h4>{p.title}</h4>
            <p>{p.summary}</p>
            <a href={`/programs/${p.slug}`}>Learn more →</a>
          </article>
        ))}
      </div>
      <p class="vgp-mt"><a class="vgp-btn vgp-btn--primary" href="/institutional-inquiry">Submit an Institutional Inquiry</a></p>
    </div>
  </section>
</Base>
