---
import Base from '../../layouts/Base.astro';
import { getPartners } from '../../lib/content';
const partners = await getPartners();
const anyPending = partners.some((p) => p.review);
// Branded monogram fallback for partners without a logo/headshot yet.
const initials = (name: string) =>
  name.replace(/[^A-Za-z ]/g, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<Base
  title="Partner Network"
  description="The referral and delivery partners in the Value Growth Partners network."
>
  <section class="vgp-section">
    <div class="vgp-container">
      <span class="vgp-eyebrow">Partner Network</span>
      <h1>The people we bring to the table</h1>
      <p style="max-width:82ch; font-size:1.15rem;">Commercial readiness rarely comes from advice alone. Value Growth Partners orchestrates a vetted network of specialists so founders get the right expertise at the right moment — financing and lending, tax and financial strategy, creative and product design, paid media, and capital and commerce intelligence. When a specialist will serve a founder better than another meeting with us, we make the introduction and stay accountable for the outcome. These are the trusted partners in the VGP network.</p>

      {anyPending && (
        <p class="vgp-review-flag" style="max-width:82ch;">
          Listings are being confirmed with each partner before this page goes public. Names, descriptions and contact details shown here are pending each partner's sign-off.
        </p>
      )}

      <div class="vgp-grid vgp-grid--2 vgp-mt">
        {partners.map((p) => (
          <article class="vgp-card pn-card">
            {p.logo
              ? <img src={p.logo} alt={`${p.name} logo`} class="partner-logo" loading="lazy" />
              : p.headshot
                ? <img src={p.headshot} alt={p.name} class="partner-headshot" loading="lazy" />
                : <span class="partner-monogram" aria-hidden="true">{initials(p.name)}</span>}
            <span class="vgp-eyebrow" style="margin-bottom:.5rem;">{p.type}</span>
            <h4 style="margin-bottom:.35rem;">{p.name}</h4>
            {p.focus && <p style="color:var(--vgp-navy);font-weight:600;margin-bottom:.5rem;">{p.focus}</p>}
            <p>{p.description}</p>
            <p class="pn-links">
              <a href={`/network/${p.slug}`}>View profile →</a>
              {p.website && (<a href={p.website} target="_blank" rel="noopener">Website ↗</a>)}
            </p>
          </article>
        ))}
      </div>

      <style>
        .partner-logo { height: 40px; width: auto; margin-bottom: 1rem; object-fit: contain; }
        .partner-headshot { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; margin-bottom: .85rem; }
        .partner-monogram {
          display: inline-flex; align-items: center; justify-content: center;
          width: 56px; height: 56px; border-radius: 50%;
          background: var(--vgp-warm-gold); color: var(--vgp-navy);
          font-family: var(--font-serif); font-weight: 700; font-size: 1.3rem;
          letter-spacing: .02em; margin-bottom: .85rem;
        }
        .pn-card { display: flex; flex-direction: column; }
        .pn-links { margin-top: auto; padding-top: .6rem; display: flex; gap: 1.25rem; }
      </style>

      <!-- Funding partners callout -->
      <div class="vgp-card vgp-bg-soft vgp-mt" style="margin-top:2.5rem;">
        <span class="vgp-eyebrow">For founders</span>
        <h3 style="margin-bottom:.4rem;">Connect with our funding partners</h3>
        <p style="margin-bottom:1rem;">Beyond service partners, VGP maintains relationships with a set of funding partners for founders who are capital-ready. We make warm, context-rich introductions when there's genuine fit.</p>
        <a class="vgp-btn vgp-btn--secondary" href="/network/funding-partners">See funding partners →</a>
      </div>

      <div class="vgp-card vgp-bg-pale vgp-center vgp-mt" style="border:none;">
        <h3>Want to partner with VGP?</h3>
        <p>If you work with founders and think there's a fit, we'd like to hear from you.</p>
        <p class="vgp-mt"><a class="vgp-btn vgp-btn--primary" href="/partner-contributor">Explore partnering →</a></p>
      </div>
    </div>
  </section>
</Base>
