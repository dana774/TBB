---
import Base from '../../layouts/Base.astro';
import { getPartners } from '../../lib/content';
export async function getStaticPaths() {
  const items = await getPartners();
  return items.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const initials = (name: string) =>
  name.replace(/[^A-Za-z ]/g, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const INTAKE = 'https://forms.gle/fG38XuGXYYeYcEUd6';
---
<Base title={`${p.name} — VGP Partner`} description={p.focus || p.description}>
  <article class="vgp-section">
    <div class="vgp-container" style="max-width:820px;">
      <nav aria-label="Breadcrumb"><a href="/network">Partner Network</a> / {p.name}</nav>

      {p.review && (
        <p class="vgp-review-flag" style="max-width:80ch;">
          Draft profile — prepared for {p.name}'s review and pending confirmation. Not yet public.
        </p>
      )}

      <div class="pd-head">
        {p.logo
          ? <img src={p.logo} alt={`${p.name} logo`} class="pd-logo" />
          : p.headshot
            ? <img src={p.headshot} alt={p.name} class="pd-headshot" />
            : <span class="pd-monogram" aria-hidden="true">{initials(p.name)}</span>}
        <div>
          <span class="vgp-eyebrow">{p.type}</span>
          <h1 style="margin:.2rem 0 .3rem;">{p.name}</h1>
          {p.founderName && <p style="margin:0 0 .3rem; color:var(--vgp-body-gray);">{p.founderName}</p>}
          {p.focus && <p style="margin:0; color:var(--vgp-navy); font-weight:600;">{p.focus}</p>}
        </div>
      </div>

      <p style="font-size:1.15rem; max-width:70ch;">{p.description}</p>
      {p.category && <p class="pd-cat"><span>Category</span> {p.category}</p>}

      {Array.isArray(p.bestFit) && p.bestFit.length > 0 && (
        <>
          <h4 class="vgp-mt">Best fit for</h4>
          <ul class="pd-list">{p.bestFit.map((b: string) => <li>{b}</li>)}</ul>
        </>
      )}

      {Array.isArray(p.engagement) && p.engagement.length > 0 && (
        <>
          <h4 class="vgp-mt">Typical engagement</h4>
          <ul class="pd-list">{p.engagement.map((e: string) => <li>{e}</li>)}</ul>
        </>
      )}

      {p.whyVgp && (
        <>
          <h4 class="vgp-mt">Why VGP recommends them</h4>
          <p style="max-width:70ch;">{p.whyVgp}</p>
        </>
      )}

      {(p.contact || p.website || p.linkedin) && (
        <>
          <h4 class="vgp-mt">Contact</h4>
          <ul class="pd-contact">
            {p.contact?.email && <li><span>Email</span> <a href={`mailto:${p.contact.email}`}>{p.contact.email}</a></li>}
            {p.contact?.phone && <li><span>Phone</span> {p.contact.phone}</li>}
            {p.contact?.location && <li><span>Location</span> {p.contact.location}</li>}
            {p.website && <li><span>Website</span> <a href={p.website} target="_blank" rel="noopener">{p.website.replace(/^https?:\/\//, '')}</a></li>}
            {p.linkedin && <li><span>LinkedIn</span> <a href={p.linkedin} target="_blank" rel="noopener">Profile ↗</a></li>}
          </ul>
        </>
      )}

      <!-- How founders engage -->
      <div class="vgp-card vgp-bg-soft vgp-mt">
        <h4 style="margin-bottom:.5rem;">How to engage</h4>
        <p style="margin-bottom:.4rem;"><strong>Direct:</strong> reach out using the details above.</p>
        <p style="margin:0;"><strong>Warm introduction via VGP (recommended):</strong> we share your stage, goals and constraints so the first conversation starts with context. <a href="/institutional-inquiry">Request an introduction →</a></p>
      </div>

      {p.review && (
        <div class="vgp-card pd-review vgp-mt">
          <span class="vgp-eyebrow" style="color:var(--vgp-warm-gold);">For {p.name}</span>
          <h4 style="margin:.3rem 0 .5rem;">Help us get your profile right</h4>
          <p style="margin-bottom:.6rem;">This is a draft we prepared so you're represented exactly the way you'd like. Please review and send back:</p>
          <ul class="pd-list">
            <li>Any edits to your name, description, focus, or contact details</li>
            <li>A headshot and/or logo, plus any work images you'd like featured</li>
            <li>Optionally, the services or rates you'd like listed</li>
          </ul>
          <p class="vgp-mt" style="margin-top:1rem;"><a class="vgp-btn vgp-btn--primary" href={INTAKE} target="_blank" rel="noopener">Review &amp; update your profile →</a></p>
        </div>
      )}

      <p class="pd-legal">
        Inclusion in the VGP partner network does not imply endorsement of a partner's pricing or scope. Partners
        operate independently and contract directly with founders. VGP may receive a referral fee where a formal
        referral arrangement applies. Founders should conduct their own diligence before engaging. This is not legal,
        financial, investment, or tax advice.
      </p>
    </div>
  </article>

  <style>
    .pd-head { display: flex; gap: 1.25rem; align-items: center; margin: 1.25rem 0 1rem; }
    .pd-logo { height: 56px; width: auto; object-fit: contain; flex: 0 0 auto; }
    .pd-headshot { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
    .pd-monogram { display: inline-flex; align-items: center; justify-content: center; width: 76px; height: 76px; border-radius: 50%; background: var(--vgp-warm-gold); color: var(--vgp-navy); font-family: var(--font-serif); font-weight: 700; font-size: 1.7rem; flex: 0 0 auto; }
    .pd-cat { color: var(--vgp-body-gray); }
    .pd-cat span { color: var(--vgp-navy); font-weight: 700; margin-right: .4rem; }
    .pd-list { max-width: 70ch; padding-left: 1.1rem; }
    .pd-list li { margin-bottom: .35rem; }
    .pd-contact { list-style: none; padding: 0; max-width: 60ch; }
    .pd-contact li { margin-bottom: .35rem; }
    .pd-contact span { display: inline-block; min-width: 84px; color: var(--vgp-navy); font-weight: 700; }
    .pd-review { border: 1px solid var(--vgp-warm-gold); background: rgba(0,0,0,.02); }
    .pd-legal { margin-top: 2rem; font-size: .8rem; color: var(--vgp-body-gray); max-width: 74ch; }
    @media (max-width: 620px) { .pd-head { flex-direction: column; align-items: flex-start; } }
  </style>
</Base>
