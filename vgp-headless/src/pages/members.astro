---
import Base from '../layouts/Base.astro';
// Active-client area. Private scheduling links are delivered by direct
// communication only — never rendered on-site. Live: wire to Wix Members.
---
<Base title="Client Sign-In" description="Active-client area.">
  <section class="vgp-section">
    <div class="vgp-container vgp-center" style="max-width:560px;">
      <span class="vgp-eyebrow">Active Clients</span>
      <h1>Client sign-in</h1>
      <p>Access to your engagement workspace. Scheduling for active clients is arranged directly with your VGP contact — never through a public link.</p>
      <p class="vgp-mt"><a class="vgp-btn vgp-btn--primary" href="#">Sign in</a></p>
      <p style="font-size:.9rem;">[EDITORIAL REVIEW] Wire to Wix Members / your auth provider when going live.</p>
    </div>
  </section>
</Base>
