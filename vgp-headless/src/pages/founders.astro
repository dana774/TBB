---
import Base from '../layouts/Base.astro';
const supports = [
  { h: 'Founder Network access', p: 'Join the ecosystem for weekly signals, funding alerts, founder visibility, resource access, and curated opportunities.' },
  { h: 'Growth OS tools & templates', p: 'Founder-ready worksheets, dashboards, forecasting tools, outreach templates, and execution playbooks.' },
  { h: 'Strategy, forecasting & readiness', p: 'Clarify your business model, pricing, margin, channel mix, funding gap, and next stage of growth.' },
  { h: 'Retail, digital & distribution', p: 'Guidance across retail readiness, email, paid media, AI search, wholesale, distribution, and launch systems.' },
  { h: 'Partner, funding & visibility', p: 'Get connected to vetted partners, funding opportunities, podcast features, Hot List visibility, and investor-readiness pathways.' },
];
const fits = [
  { h: 'Early-traction founders', p: 'A product, service, audience, or pilot traction — and a need for structure.' },
  { h: 'CPG, beauty & retail brands', p: 'Consumer brands preparing for retail, wholesale, ecommerce, or channel expansion.' },
  { h: 'Capital-seeking founders', p: 'Preparing for grants, pitch opportunities, investor conversations, or forecast-driven capital planning.' },
  { h: 'Founders needing systems', p: 'Those who need dashboards, workflows, operating discipline, and accountability.' },
];
const steps = [
  ['Join', 'Enter the Founder Network, the intake process, or an advisory pathway.'],
  ['Diagnose', 'Clarify business model, growth stage, gaps, and priority metrics.'],
  ['Build', 'Use tools, dashboards, strategy, and partner support to strengthen the business.'],
  ['Activate', 'Move into retail, funding, marketing, operations, or capital readiness.'],
  ['Scale', 'Stay connected through referrals, visibility, and ongoing support.'],
];
const BB_URL = import.meta.env.BB_URL || 'https://the-brand-blueprint.myshopify.com';
---
<Base title="For Founders" description="Build the operating system behind your next stage — from traction to structure, with Value Growth Partners.">
  <section class="vgp-section">
    <div class="vgp-container" style="max-width:820px;">
      <span class="vgp-eyebrow">For Founders</span>
      <h1>Build the operating system behind your next stage.</h1>
      <p style="font-size:1.25rem; max-width:66ch;">The ecosystem helps founders move from traction to structure — combining education, tools, advisory, funding intelligence, visibility, vetted partners, and VGP-powered operating support so emerging brands grow with more discipline and less guesswork. We turn strategy into systems, and systems into repeatable growth.</p>
    </div>
  </section>

  <section class="vgp-section vgp-bg-soft">
    <div class="vgp-container">
      <span class="vgp-eyebrow">How we support founders</span>
      <h2>From traction to structure.</h2>
      <div class="vgp-grid vgp-grid--3 vgp-mt">
        {supports.map((s) => <article class="vgp-card"><h4>{s.h}</h4><p style="margin-bottom:0;">{s.p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="vgp-section vgp-bg-navy vgp-center">
    <div class="vgp-container" style="max-width:720px;">
      <p style="font-family:var(--font-serif); font-size:1.9rem; line-height:1.3; color:#fff; margin:0 0 1rem;">“We help founders move from ideas and traction into systems, execution, and scale.”</p>
      <p style="color:var(--vgp-warm-gold); font-weight:600; margin:0;">Dana Ammons · Founder &amp; Principal, Value Growth Partners</p>
    </div>
  </section>

  <section class="vgp-section">
    <div class="vgp-container">
      <span class="vgp-eyebrow">How it works</span>
      <h2>Join. Diagnose. Build. Activate. Scale.</h2>
      <div class="fd-steps vgp-mt">
        {steps.map(([t, d], i) => (
          <div class="fd-step"><span class="fd-num">{i + 1}</span><h4 style="margin:.5rem 0 .35rem;">{t}</h4><p style="font-size:.95rem; margin:0;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="vgp-section vgp-bg-pale">
    <div class="vgp-container">
      <span class="vgp-eyebrow">Who this is best for</span>
      <div class="vgp-grid vgp-grid--2 vgp-mt">
        {fits.map((f) => <article class="vgp-card"><h4>{f.h}</h4><p style="margin-bottom:0;">{f.p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="vgp-section vgp-bg-navy vgp-center">
    <div class="vgp-container" style="max-width:640px;">
      <h2 style="font-size:var(--vgp-h3);">Let’s build the system behind your growth.</h2>
      <p style="max-width:54ch; margin:0 auto 1.75rem;">Start with the Founder Network, a diagnostic session, or a VGP advisory pathway — designed to move you from ideas and traction into systems, execution, and scale.</p>
      <p>
        <a class="vgp-btn vgp-btn--primary" href="/membership" style="margin-right:.5rem;">Join the Founder Network — $99/mo</a>
        <a class="vgp-btn vgp-btn--secondary" href="/advisory-pathway">Start the Advisory Pathway</a>
      </p>
    </div>
  </section>

  <style>
    .fd-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.25rem; }
    .fd-step { border-top: 3px solid var(--vgp-warm-gold); padding-top: 1rem; }
    .fd-num { font-family: var(--font-serif); font-size: 2rem; color: var(--vgp-blueprint-blue); }
    @media (max-width: 900px) { .fd-steps { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 520px) { .fd-steps { grid-template-columns: 1fr; } }
  </style>
</Base>
