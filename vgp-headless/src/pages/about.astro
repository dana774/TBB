---
import Base from '../layouts/Base.astro';
import { getDanaProfile } from '../lib/content';
const dana = await getDanaProfile();
// The $115M PepsiCo figure renders ONLY when pepsico_claim_status === 'approved' (doc 07 §2).
const showPepsico = dana.pepsico_claim_status === 'approved' && dana.pepsico_claim;
const BB_URL = import.meta.env.BB_URL || 'https://the-brand-blueprint.myshopify.com';
// Placeholder monogram below. To use a real headshot, drop the image in
// public/assets/ and swap the `.about-photo` div for an <img>.
---
<Base title="About Dana Ammons" description="Founder & principal, Value Growth Partners.">
  <section class="vgp-section">
    <div class="vgp-container" style="max-width:900px;">
      <span class="vgp-eyebrow">About</span>

      <div class="about-hero">
        <div class="about-photo" aria-hidden="true">DA</div>
        <div>
          <h1 style="margin-bottom:.5rem;">Dana Ammons</h1>
          <p style="font-size:1.25rem;margin-bottom:0;">{dana.positioning}</p>
        </div>
      </div>

      {dana.sourced && (
        <p class="vgp-review-flag" style="max-width:70ch;">Biography drafted from public sources — pending Dana's confirmation before launch.</p>
      )}
      {showPepsico && <p>{dana.pepsico_claim}</p>}

      <h4 class="vgp-mt">Operating philosophy</h4>
      <p style="max-width:68ch;">{dana.philosophy}</p>

      <h4>Experience</h4>
      <p style="max-width:68ch;">{dana.experience_timeline}</p>

      {Array.isArray(dana.credentials) && dana.credentials.length > 0 && (
        <>
          <h4>Background</h4>
          <ul class="about-creds">
            {dana.credentials.map((c: string) => <li>{c}</li>)}
          </ul>
        </>
      )}

      <div class="vgp-grid vgp-grid--2 vgp-mt">
        <a class="vgp-card" href="/advisory-pathway"><h4>Work with VGP</h4><p>Start the Advisory Pathway.</p></a>
        <a class="vgp-card" href={BB_URL} data-evt="cross_domain_route"><h4>The Brand Blueprint</h4><p>The founder ecosystem side.</p></a>
      </div>
    </div>
  </section>

  <style>
    .about-hero { display: flex; gap: 1.75rem; align-items: center; margin-bottom: 1.5rem; }
    .about-photo {
      flex: 0 0 auto; width: 120px; height: 120px; border-radius: 50%;
      background: var(--vgp-navy); color: #fff; display: grid; place-items: center;
      font-family: var(--font-serif); font-size: 2.5rem; letter-spacing: .05em;
    }
    .about-creds { max-width: 68ch; padding-left: 1.1rem; }
    .about-creds li { margin-bottom: .5rem; }
    @media (max-width: 620px) { .about-hero { flex-direction: column; align-items: flex-start; } }
  </style>
</Base>
