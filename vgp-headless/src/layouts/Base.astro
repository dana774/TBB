---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  podcast?: boolean;
}
const { title, description = 'Value Growth Partners — strategic advisory and institutional programs.' } = Astro.props;
const fullTitle = title === 'Value Growth Partners' ? title : `${title} | Value Growth Partners`;
// HubSpot analytics/attribution — loads only when the portal is set at deploy
// (set PUBLIC_HUBSPOT_PORTAL_ID=246956537 in prod; left off in staging).
const hsPortal = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID;
// Search indexing is OFF by default (every preview/staging deploy stays noindex).
// To go live: set PUBLIC_ALLOW_INDEX=true on the production Vercel environment and
// redeploy — only then does the site become indexable.
const allowIndex = import.meta.env.PUBLIC_ALLOW_INDEX === 'true';
// Canonical always points at the real domain (astro.config `site`), so even if the
// *.vercel.app URL is reachable, search consolidates to www.valugrowthpartners.com.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!allowIndex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/vgp-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/brand/vgp-favicon-192.png" />
    <link rel="apple-touch-icon" href="/assets/brand/vgp-favicon-192.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Value Growth Partners',
      url: 'https://www.valugrowthpartners.com',
      founder: { '@type': 'Person', name: 'Dana Ammons' },
    })} />
    {hsPortal && (
      <script is:inline async defer id="hs-script-loader" src={`https://js.hs-scripts.com/${hsPortal}.js`}></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
