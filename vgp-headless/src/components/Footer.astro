---
const year = new Date().getFullYear();
---
<footer class="vgp-bg-navy vgp-footer">
  <div class="vgp-container vgp-footer__inner">
    <div>
      <p class="vgp-footer__brand">Value Growth Partners</p>
      <p class="vgp-footer__tag">Strategic advisory for founders and the organizations that support them.</p>
    </div>
    <nav class="vgp-footer__links" aria-label="Footer">
      <a href="/advisory-pathway">Advisory Pathway</a>
      <a href="/institutional-inquiry">Institutional Inquiry</a>
      <a href="/insights">Insights</a>
      <a href="/about">About</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/accessibility">Accessibility</a>
    </nav>
  </div>
  <div class="vgp-container vgp-footer__legal">© {year} Value Growth Partners. [EDITORIAL REVIEW — staging]</div>
</footer>
<style>
  .vgp-footer { padding: 72px 0 32px; }
  .vgp-footer__inner { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .vgp-footer__brand { font-family: var(--font-serif); font-size: 1.25rem; color: #fff; margin: 0 0 .5rem; }
  .vgp-footer__tag { max-width: 30ch; }
  .vgp-footer__links { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem 2rem; }
  .vgp-footer__links a { color: rgba(255,255,255,.85); text-decoration: none; font-size: .95rem; }
  .vgp-footer__links a:hover { color: #fff; }
  .vgp-footer__legal { margin-top: 2.5rem; font-size: .8125rem; color: rgba(255,255,255,.6); }
</style>
