---
const links = [
  { href: '/ecosystem', label: 'Ecosystem' },
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/how-we-work', label: 'How We Work' },
  { href: '/programs', label: 'Programs' },
  { href: '/investors-partners', label: 'Investors' },
  { href: '/membership', label: 'Membership' },
  { href: '/insights', label: 'Insights' },
  { href: '/about', label: 'About' },
];
---
<header class="vgp-nav">
  <div class="vgp-container vgp-nav__inner">
    <a href="/" class="vgp-nav__logo" aria-label="Value Growth Partners — home">
      <img src="/assets/brand/vgp-logo-primary-horizontal.png" alt="Value Growth Partners" width="2013" height="540" />
    </a>
    <button class="vgp-nav__toggle" aria-expanded="false" aria-controls="vgp-menu" aria-label="Menu">Menu</button>
    <nav id="vgp-menu" class="vgp-nav__menu" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="vgp-btn vgp-btn--primary vgp-nav__cta" href="/advisory-pathway">Start the Advisory Pathway</a>
    </nav>
  </div>
</header>
<style>
  .vgp-nav { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--vgp-card-border); }
  .vgp-nav__inner { display: flex; align-items: center; justify-content: space-between; min-height: 96px; gap: 1.5rem; }
  .vgp-nav__logo { display: inline-flex; align-items: center; text-decoration: none; }
  .vgp-nav__logo img { height: 56px; width: auto; display: block; }
  .vgp-nav__menu { display: flex; align-items: center; gap: 1.15rem; }
  .vgp-nav__menu a { color: var(--vgp-navy); text-decoration: none; font-size: .9rem; white-space: nowrap; }
  .vgp-nav__menu a:hover { color: var(--vgp-blueprint-blue); }
  .vgp-nav__cta { color: #fff !important; }
  .vgp-nav__toggle { display: none; background: none; border: 1px solid var(--vgp-card-border); border-radius: var(--vgp-radius); padding: .5rem .9rem; font: inherit; cursor: pointer; }
  @media (max-width: 1024px) {
    .vgp-nav__toggle { display: block; }
    .vgp-nav__menu { position: absolute; left: 0; right: 0; top: 96px; background: #fff; flex-direction: column; align-items: stretch; gap: 0; padding: .5rem 0; border-bottom: 1px solid var(--vgp-card-border); display: none; }
    .vgp-nav__menu[data-open] { display: flex; }
    .vgp-nav__menu a { padding: .8rem var(--vgp-gutter); }
    .vgp-nav__cta { margin: .5rem var(--vgp-gutter); text-align: center; }
  }
</style>
<script>
  const btn = document.querySelector('.vgp-nav__toggle');
  const menu = document.getElementById('vgp-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.toggleAttribute('data-open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
