# --- HubSpot (primary CRM + Commerce) ---
# Private App token with scope crm.objects.contacts.write.
# HubSpot → Settings → Integrations → Private Apps → create → copy token.
# Optional custom contact properties for segmentation: vgp_pathway, vgp_source, vgp_message.
HUBSPOT_TOKEN=

# --- Scheduling ---
# Approved public fit-call URL (the ONLY public Calendly). Server-rendered,
# returned only on the qualified advisory-pathway result.
FIT_CALL_URL=https://calendly.com/valugrowthpartners/vgp-insight-session

# --- Cross-brand ---
BB_URL=https://the-brand-blueprint.myshopify.com

# --- (Deprecated) Wix headless data ---
# Wix is being retired; content now lives in the repo (src/lib/content.ts).
# Left here only if you temporarily read Wix CMS during transition.
PUBLIC_WIX_CLIENT_ID=
