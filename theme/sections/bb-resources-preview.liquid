{% comment %} Resource Library preview with Public/Member badges (doc 08 §2.9). {% endcomment %}
{%- assign resources = shop.metaobjects.resource.values -%}
<section class="bb-section">
  <div class="bb-container">
    <span class="bb-eyebrow">Resource Library</span>
    <h2 class="bb-h2">{{ section.settings.heading }}</h2>
    {%- if resources.size > 0 -%}
      <div class="bb-grid bb-grid--3">
        {%- for resource in resources limit: section.settings.limit -%}
          {% render 'bb-card-resource', resource: resource %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="bb-callout"><p>No resources yet. Create <code>resource</code> metaobject entries — this preview fills automatically.</p></div>
    {%- endif -%}
    <p class="bb-mt-2"><a href="{{ section.settings.link | default: '/pages/resources' }}">Browse the Resource Library</a></p>
  </div>
</section>

{% schema %}
{
  "name": "BB Resources Preview",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Templates, guides and playbooks" },
    { "type": "range", "id": "limit", "label": "Resources shown", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "url", "id": "link", "label": "Library link" }
  ],
  "presets": [{ "name": "BB Resources Preview" }]
}
{% endschema %}
