{% comment %} Split editorial hero — doc 08 §2.3. 7/5 columns, offset Founder Signal card. {% endcomment %}
<section class="bb-section">
  <div class="bb-container">
    <div class="bb-hero">
      <div class="bb-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="bb-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="bb-h1">{{ section.settings.heading }}</h1>
        {%- if section.settings.subhead != blank -%}
          <p>{{ section.settings.subhead }}</p>
        {%- endif -%}
        <div class="bb-mt-2">
          <a class="bb-btn bb-btn--primary" href="{{ section.settings.primary_link | default: '/pages/founder-intake' }}">
            {{- section.settings.primary_label | default: 'Complete the Founder Intake' -}}
          </a>
          {%- if section.settings.secondary_label != blank -%}
            <a class="bb-btn bb-btn--secondary" href="{{ section.settings.secondary_link | default: '/pages/founders' }}">
              {{- section.settings.secondary_label -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="bb-hero__media">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="{{ section.settings.image.alt | escape }}"
            width="1000"
            height="{{ 1000 | divided_by: section.settings.image.aspect_ratio | round }}"
            fetchpriority="high"
          >
        {%- else -%}
          <div class="bb-callout" style="aspect-ratio: 4 / 5;" role="img" aria-label="Placeholder — hero photograph pending (asset request list, doc 05)"></div>
        {%- endif -%}
        {%- if section.settings.signal_text != blank -%}
          <aside class="bb-hero__signal-card">
            <span class="bb-eyebrow">Founder Signal</span>
            <p>{{ section.settings.signal_text }}</p>
            <a href="{{ section.settings.signal_link | default: '/pages/signals' }}">Visit the Signals Hub</a>
          </aside>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BB Editorial Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Founder Ecosystem" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build a brand that earns its place on the shelf." },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Founder Chapters, market signals and an eight-stage framework for consumer brands ready to grow. [EDITORIAL REVIEW]" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Complete the Founder Intake" },
    { "type": "url", "id": "primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label", "default": "Explore Founder Chapters" },
    { "type": "url", "id": "secondary_link", "label": "Secondary CTA link" },
    { "type": "image_picker", "id": "image", "label": "Hero photograph" },
    { "type": "text", "id": "signal_text", "label": "Founder Signal insight", "default": "Retail buyers are prioritizing brands with proven velocity data. [EDITORIAL REVIEW]" },
    { "type": "url", "id": "signal_link", "label": "Signal link" }
  ],
  "presets": [{ "name": "BB Editorial Hero" }]
}
{% endschema %}
