{% comment %}
  Newsletter signup — native Shopify customer form with explicit marketing consent.
  Creates/updates a customer tagged `newsletter`; no email app required.
{% endcomment %}
<section class="bb-section bb-bg-pale">
  <div class="bb-container bb-center" style="max-width: 640px;">
    <span class="bb-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="bb-h2">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {%- form 'customer', class: 'bb-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="bb-callout" role="status" tabindex="-1" autofocus>You're on the list. Watch for the next Market Signal.</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="bb-field-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
          <label class="bb-visually-hidden" for="bb-newsletter-email-{{ section.id }}">Email address</label>
          <input
            id="bb-newsletter-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            required
            autocomplete="email"
            placeholder="you@company.com"
            style="flex: 1 1 280px; padding: 0.9rem 1rem; border: 1px solid var(--bb-card-border); border-radius: var(--bb-radius); font-size: 1rem;"
          >
          <button type="submit" class="bb-btn bb-btn--primary">{{ section.settings.cta }}</button>
        </div>
        <p style="font-size: 0.8125rem;" class="bb-mt-2">By subscribing you agree to receive Brand Blueprint emails. Unsubscribe anytime.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "BB Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Signal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Market signals, in your inbox" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "One concise email with the signals, funding windows and founder lessons that matter. [EDITORIAL REVIEW]" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "BB Newsletter" }]
}
{% endschema %}
